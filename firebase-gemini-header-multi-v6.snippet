#!name=Firebase Gemini Header 多專案同步 v6
#!desc=修正 QX 原生 $task.fetch 相容性，Dump Note 與 To-Do Speak 分流同步至同一 Private HF Space，成功顯示通知
#!author=Minis

[rewrite_local]
^https:\/\/firebasevertexai\.googleapis\.com\/v1beta\/projects\/(?:dump-note-ai|to-do-speak-ai)\/models\/gemini-.* url script-request-header https://raw.githubusercontent.com/w902287/qx-firebase-appcheck-multi/main/firebase-gemini-header-multi-sync-v6.js

[mitm]
hostname = %APPEND% firebasevertexai.googleapis.com
